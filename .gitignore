# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
# Ignore every .env variant, then re-allow the committed examples. The previous
# `.env*.local` pattern left a real `.env` — the file that actually holds keys —
# fully committable.
.env
.env.*
!.env.example
!env.example

# test output
coverage/

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android
