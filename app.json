{
  "expo": {
    "name": "my-app",
    "slug": "my-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to show nearby rides and set pickup points.",
        "NSPhotoLibraryUsageDescription": "We need access to your photos to upload your profile picture and documents.",
        "NSCameraUsageDescription": "We need camera access to take your profile picture and document photos."
      },
      "bundleIdentifier": "com.anonymous.my-app",
      "appleTeamId": "VMZ7JTG4TU"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E87C3E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBE9D6",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "We use your location to show nearby rides and set pickup points."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "We need access to your photos to upload your profile picture and documents.",
          "cameraPermission": "We need camera access to take your profile picture and document photos."
        }
      ],
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
