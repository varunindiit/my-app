# Copy this file to .env and fill in your values. The CLI seeds .env for you.
# .env is git-ignored; .env.example is committed as the template.

# ─── Client-safe (EXPO_PUBLIC_*) ─────────────────────────────────────────────
# Inlined into the JS bundle at build time and readable via process.env in app
# code. NEVER put real secrets here — anything EXPO_PUBLIC_ ships to the client.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=http://13.134.217.35/api/v1
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─── Build-time config (read by app.config.js → expo.extra) ──────────────────
# Embedded via app config and read through expo-constants. Inject the real
# secret values via EAS env/secrets in CI for production builds.
APP_ENV=development
API_URL=http://13.134.217.35/api/v1
GOOGLE_MAPS_API_KEY=

# ─── EAS ─────────────────────────────────────────────────────────────────────
# Set after running `eas init` (or from your EAS project settings).
EAS_PROJECT_ID=
