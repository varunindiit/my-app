# Copy this file to .env and fill in your values. The CLI seeds .env for you.
# .env is git-ignored; .env.example is committed as the template.
#
# ─────────────────────────────────────────────────────────────────────────────
# SECURITY: nothing in this file is secret.
#
# Both layers below are baked into the JavaScript bundle that ships to devices.
# Anyone with the .ipa/.apk can read them in minutes. Use these for public
# endpoints and publishable keys only. Anything that can be billed, or that
# grants write access, belongs on a server you control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Client-safe (EXPO_PUBLIC_*) ─────────────────────────────────────────────
# Inlined into the JS bundle at build time and readable via process.env in app
# code. See src/services/Config.ts.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=https://api.example.com

# Path on your API that exchanges a refresh token for a new access token.
# Used by the axios interceptor in src/services/api.ts.
EXPO_PUBLIC_REFRESH_PATH=/auth/refresh

# Axios timeout in milliseconds.
EXPO_PUBLIC_REQUEST_TIMEOUT_MS=20000

# ─── Places / geocoding ──────────────────────────────────────────────────────
# By default the app calls YOUR backend at `${API_URL}${PLACES_PROXY_PATH}`,
# which forwards to Google with a server-side key. See
# docs/google-places-proxy.md for a reference implementation.
EXPO_PUBLIC_PLACES_PROXY_PATH=/places

# Local prototyping escape hatch: call Google directly from the device.
# The key below then ships inside your bundle and is billable by anyone who
# extracts it, so keep a hard quota cap on it. The app refuses to use direct
# mode in a production build.
EXPO_PUBLIC_PLACES_DIRECT_MODE=false
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─── Monitoring ──────────────────────────────────────────────────────────────
# Empty disables reporting. Wire your provider in src/services/monitoring.ts.
EXPO_PUBLIC_SENTRY_DSN=

# ─── Build-time config (read by app.config.js → expo.extra) ──────────────────
# Embedded via app config and read through expo-constants. Inject the real
# values via EAS env/secrets in CI for production builds.
APP_ENV=development
API_URL=https://api.example.com
GOOGLE_MAPS_API_KEY=
SENTRY_DSN=

# ─── EAS ─────────────────────────────────────────────────────────────────────
# Set after running `eas init` (or from your EAS project settings).
EAS_PROJECT_ID=
